# =============================================================
# QA Flash - UI | Arquivo de Configuracao (.env)
# COPIE este arquivo para .env e preencha com os valores reais
# O arquivo .env NAO sobe para o GitHub (esta no .gitignore)
# =============================================================

# URL base do Mercado Livre
url.mercadolivre=https://www.mercadolivre.com.br

# Configuracao do navegador
modo.anonimo=false

# Timeout de espera explicita (em segundos)
timeout.padrao=15

